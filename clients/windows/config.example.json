{
  "cloudflare_api_base": "https://<bridge-domain>",
  "bridge_health_path": "/health",
  "cloudflare_api_key": "<bridge-management-secret>",
  "cloudflare_auth_mode": "bearer",
  "cloudflare_path_domains": "/api/domains",
  "cloudflare_path_accounts": "/admin/new_address",
  "cloudflare_path_token": "/api/token",
  "cloudflare_path_messages": "/api/mails",
  "email_provider": "cloudflare",
  "defaultDomains": "<mail-domain>",
  "proxy": "http://127.0.0.1:10808",
  "register_count": 1,
  "max_concurrency": 1,
  "target_successes": 0,
  "accounts_output_dir": "",
  "mail_credentials_file": "",
  "success_records_file": "",
  "enable_nsfw": false,
  "hide_window": true,
  "block_media_fonts": false,
  "stealth_patch": false,
  "cpa_export_enabled": true,
  "cpa_auth_dir": "./cpa_auths",
  "cpa_base_url": "https://cli-chat-proxy.grok.com/v1",
  "cpa_push_enabled": true,
  "cpa_remote_base": "https://<bridge-domain>",
  "cpa_remote_secret": "<bridge-management-secret>",
  "cpa_remote_verify_tls": true,
  "cpa_push_proxy": "",
  "cpa_push_required": true,
  "cpa_require_probe_passed": true,
  "cpa_require_created": false,
  "cpa_push_timeout_sec": 240,
  "mint_proxy": "",
  "mint_timeout_sec": 300,
  "mint_required": true,
  "cpa_preprobe_enabled": true,
  "cpa_preprobe_required": true,
  "cpa_preprobe_timeout_sec": 45,
  "cpa_preprobe_refresh_on_invalid": true,
  "cpa_preprobe_attempts": 3,
  "cpa_preprobe_retry_delay_sec": 4,
  "cpa_preprobe_permission_retry_delay_sec": 0
}
