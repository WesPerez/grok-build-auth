[Unit]
Description=Grok Register Bridge (Email API and Sub2API Auth Push)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/grok-build-auth
EnvironmentFile=/root/grok-build-auth/private/bridge.env
ExecStart=/usr/bin/python3 -u /root/grok-build-auth/bridge/bridge.py
Restart=on-failure
RestartSec=3
UMask=0077

[Install]
WantedBy=multi-user.target
