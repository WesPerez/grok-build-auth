# Copy to private/runtime.env and chmod 600. Never commit private/.
YESCAPTCHA_API_KEY=
IMAP_SERVER=
IMAP_PORT=143
IMAP_SSL=false
IMAP_PASSWORD=
GROK_MAX_REGISTRATION_WORKERS=2
GROK_PREIMPORT_PROBE_MAX_WAIT_SECONDS=900
GROK_PREIMPORT_PROBE_RETRY_INTERVAL_SECONDS=60
# Required 0600 version=2 Resin JSON file. Proxy failures never fall back to direct.
GROK_PROXY_POOL_FILE=
GROK_BIND_SUB2API_PROXY_AFTER_IMPORT=false
GROK_ALLOW_MISSING_SUB2API_PROXY_IDS=false
GROK_PROXY_ROTATION_STATE_FILE=/absolute/path/private/proxy-rotation.json
GROK_PROXY_HEALTH_ATTEMPTS=3
GROK_PROXY_HEALTH_TIMEOUT=10
GROK_BROWSER_PROXY_URL=
GROK_BROWSER_HEADED=true
# Resin endpoint credentials are loaded from each proxy manifest entry's 0600 token_file.

MAILU_DOMAIN=
MAILU_DB=/opt/mailu/data/main.db
MAILU_ADMIN_CONTAINER=mailu-admin
MAILU_FLASK_BIN=/app/venv/bin/flask
MAILU_IMAP_CONTAINER=mailu-imap
MAILU_MAIL_ROOT=/mail

SUB2API_ENV=
SUB2API_ENVIRONMENT=
SUB2API_URL=http://<sub2api-loopback-host>:<sub2api-management-port>
SUB2API_GROUP=grok
GROK_ACCOUNT_BASE_URL=https://cli-chat-proxy.grok.com/v1
SUB2API_POSTGRES_CONTAINER=
SUB2API_PG_USER=
SUB2API_PG_DB=
SUB2API_IMPORT_TOOL=
