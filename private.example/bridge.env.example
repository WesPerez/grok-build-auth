# Copy to private/bridge.env and chmod 600.
MAILU_API_BASE=https://<bridge-domain>/mailu-api/v1
MAILU_API_TOKEN_FILE=/absolute/path/to/mailu_api_token
MAILU_DOMAIN=<mail-domain>
MAILU_IMAP_HOST=<imap-host>
MAILU_IMAP_PORT=993

SUB2API_BASE=http://127.0.0.1:13080
SUB2API_ADMIN_KEY_FILE=/absolute/path/to/sub2api_admin_key
SUB2API_GROK_GROUP_ID=<numeric-group-id>
SUB2API_POSTGRES_CONTAINER=<postgres-container>
SUB2API_PG_USER=<postgres-user>
SUB2API_PG_DB=<postgres-database>

BRIDGE_MANAGEMENT_KEY_FILE=/absolute/path/to/bridge_management_key
BRIDGE_JWT_SECRET_FILE=/absolute/path/to/bridge_jwt_secret
BRIDGE_PORT=8190
